# 기본적으로 기존 Hermes의 TELEGRAM_BOT_TOKEN과 TELEGRAM_HOME_CHANNEL을 사용합니다.
# 전용 봇으로 바꿀 때만 두 항목을 함께 설정하세요. 실제 값은 .env.local에 저장합니다.
TWIN_TELEGRAM_BOT_TOKEN=
TWIN_TELEGRAM_CHAT_ID=
# 그룹/개인 포럼 토픽을 지정할 때만 설정합니다.
TWIN_TELEGRAM_THREAD_ID=

# 프로젝트 전용 그룹에서 원격 지시를 허용할 때만 사용자 숫자 ID 목록을 설정합니다.
TWIN_TELEGRAM_ALLOWED_USERS=
